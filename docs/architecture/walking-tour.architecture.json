  "cards": [
    {
      "dot": "amber",
      "title": "New overlay: static and independent",
      "items": [
        "Export → convert → fetch → transform → circles.",
        "No live DB query, public-item check, or tour filter.",
        "Source changes require regeneration of the file."
      ]
    },
    {
      "dot": "cyan",
      "title": "Coordinate contract",
      "items": [
        "Use maps[0]; prefer transformToResource, else transformBackward.",
        "imageZoom = resource.height / map element height.",
        "Divide image x/y by imageZoom; keep feature properties."
      ]
    },
    {
      "dot": "violet",
      "title": "Existing tour path + current limits",
      "items": [
        "POST query → public tour items → same coordinate helper → numbered pins.",
        "Pin click: POST get-item → item details; overlay uses a simple popup.",
        "Overlay errors log to console; no layer toggle or explicit Y flip."
      ]
    }
  ]
